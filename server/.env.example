# Stexx API environment. Copy to .env (git-ignored) for local dev. Bun loads .env automatically.
# Generate secrets with: openssl rand -hex 32

# development | test | production. Production refuses to boot with any STEXX_DEV_* flag set.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Local dev Postgres from docker-compose.dev.yml (bound to 127.0.0.1 only).
DATABASE_URL=postgres://stexx:stexx@127.0.0.1:55433/stexx
# Used by `bun test` (test/setup.ts points DATABASE_URL here) and `bun run db:migrate:test`.
TEST_DATABASE_URL=postgres://stexx:stexx@127.0.0.1:55433/stexx_test
DATABASE_POOL_MAX=10

# Media: flat dir of <128-bit random>.jpg files. Dev serves it read-only at /media; prod Caddy serves it.
MEDIA_DIR=./media
MEDIA_BASE_URL=http://127.0.0.1:8787/media

# Email sign-in. Addresses are never stored: only HMAC-SHA256(EMAIL_PEPPER, lowercase(trim(email))).
# REQUIRED in production (>= 32 chars, unique). Changing it orphans every email account.
EMAIL_PEPPER=change-me-openssl-rand-hex-32
# Link sent by email: ${APP_LINK_BASE}/auth/email?token=...
APP_LINK_BASE=https://stexx.gay
# Optional. Unset → dev prints links to stdout; production returns 503 email_unavailable.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=Stexx <no-reply@stexx.gay>

# Passkeys (WebAuthn). Production: WEBAUTHN_RP_ID=stexx.gay, WEBAUTHN_ORIGINS=https://stexx.gay
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Stexx
WEBAUTHN_ORIGINS=http://localhost:8787

# Stexx+ via StoreKit 2. Verification is enabled only when APPLE_ROOT_CA_DIR is set (and, for Production,
# APPLE_APP_APPLE_ID). Otherwise POST /v1/subscriptions/apple → 503 subscriptions_unavailable.
# Local purchase testing (Xcode, "Stexx Local" scheme with ios/StoreKit/Stexx.storekit): set
# APPLE_ENVIRONMENT=Xcode and APPLE_ROOT_CA_DIR=./certs. Xcode mode skips Apple's signature chain, so
# production refuses to boot with anything but APPLE_ENVIRONMENT=Production.
APPLE_BUNDLE_ID=gay.stexx.app
APPLE_ENVIRONMENT=Sandbox
# APPLE_APP_APPLE_ID=
# APPLE_ROOT_CA_DIR=./deploy/apple-root-ca
APPLE_PLUS_PRODUCT_ID=gay.stexx.app.plus.monthly

# Anti-spam (docs/security.md). Development defaults to ATTESTATION_MODE=dev: real App Attest assertions are
# verified, and the simulator's "X-Stexx-Attestation: dev-bypass" header (Stexx Local scheme) is accepted.
# ATTESTATION_MODE=dev
# APPLE_TEAM_ID=
# DEVICECHECK_KEY_ID=
# DEVICECHECK_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# MAX_ACCOUNTS_PER_DEVICE=1
# TRUST_RAMP_ENABLED=1
# RATE_LIMIT_SIGNUP_IP=10/1h
# REPORT_AUTOHIDE_THRESHOLD=3

# Trust CF-Connecting-IP / X-Forwarded-For only from a loopback peer (Caddy). Used transiently for rate limits.
TRUST_PROXY=1

# Photo checks (docs/security.md "Photo checks"). Fetch the model with: sh scripts/fetch-photo-model.sh
# Without it uploads still work and photos stay unchecked. Defaults shown.
# PHOTO_CLASSIFIER=auto
# PHOTO_NSFW_MODEL=./models/nudenet-320n.onnx
# PHOTO_NSFW_THRESHOLD=0.5
# PHOTO_HIDE_UNCHECKED=0
# PHOTO_DUPLICATE_MAX_DISTANCE=6
# PHOTO_HASH_BLOCKLIST=

# Staff console (`bun run admin`, src/admin/*, docs/security.md "Staff console"). A separate process on its own port.
# In development everything has a default (http://localhost:8788, loopback allowed); these are the knobs.
# ADMIN_HOST must be loopback in production; ADMIN_ORIGIN (https) is required there. Production values: deploy/admin.env.example.
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8788
# ADMIN_ORIGIN=http://localhost:8788
# ADMIN_RP_ID=localhost
# ADMIN_RP_NAME=Stexx staff
# ADMIN_ALLOWED_CIDRS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48
# ADMIN_SESSION_IDLE_MINUTES=30
# ADMIN_SESSION_ABSOLUTE_HOURS=8
# ADMIN_STEP_UP_MINUTES=5

# ---- Dev only (all must be unset/0 in production) ----
# /auth/register returns a Session directly; mounts /v1/dev/* routes.
STEXX_DEV_AUTH=1
# New dev users get this cell (the iOS app doesn't send Core Location yet).
STEXX_DEV_DEFAULT_LOCATION=37.7749,-122.4194
# Seeded users open conversations/taps with each newly registered dev user.
STEXX_DEV_WELCOME=1
# Seeded bots reply to messages.
STEXX_DEV_BOTS=1
# Sign in to the console as a seeded staff handle (dev-support, dev-mod, dev-admin; `bun run db:seed`) without a
# passkey. Needs a loopback ADMIN_HOST; production refuses to boot with it set.
# ADMIN_DEV_AUTH=1
