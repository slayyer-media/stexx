{
  "_about": [
    "Stexx content rules shared by the server (server/src/lib/abuse/handles.ts, content.ts) and the iOS app",
    "(ios/Stexx/E2E/E2EContentRules.swift). Edit server/src/lib/abuse/content-rules.json, then copy it to",
    "ios/Stexx/E2E/content-rules.json; server/test/spam-content.test.ts fails while the two differ, and both test",
    "suites run every vector below. Patterns must work in JavaScript (no 'u' flag) and ICU (NSRegularExpression):",
    "spell word boundaries as lookarounds, use ASCII classes, never start a class with ':'.",
    "Text is normalized first: NFKC, then zero-width characters (U+200B-U+200D, U+2060, U+FEFF) are removed."
  ],
  "version": 1,
  "handleRules": [
    {
      "id": "cashapp",
      "kind": "payment",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])cash(?:\\s*(?:\\.|dot|\\(dot\\)|\\[dot\\])\\s*|\\s*)app(?:\\s*(?:\\.|dot|\\(dot\\)|\\[dot\\])\\s*com)?[^A-Za-z0-9\\$]{0,5}(?:[@:]\\s*\\$?|\\$)[A-Za-z][A-Za-z0-9_-]{1,19}"
    },
    {
      "id": "cashtag",
      "kind": "payment",
      "caseInsensitive": false,
      "pattern": "(?<![A-Za-z0-9_\\$])\\$[A-Za-z][A-Za-z0-9_]{2,19}(?![A-Za-z0-9_])"
    },
    {
      "id": "venmo",
      "kind": "payment",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])venmo(?:\\s*(?:\\.|dot|\\(dot\\)|\\[dot\\])\\s*com\\s*/\\s*(?:u/)?|[^A-Za-z0-9@]{0,5}(?:me\\s*)?[@:])\\s*@?[A-Za-z0-9_-]{3,30}"
    },
    {
      "id": "paypal",
      "kind": "payment",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])paypal(?:\\s*(?:\\.|dot|\\(dot\\)|\\[dot\\])\\s*me\\s*/?|[^A-Za-z0-9@]{0,5}(?:me\\s*)?[@:])\\s*@?[A-Za-z0-9_.-]{2,40}"
    },
    {
      "id": "zelle",
      "kind": "payment",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])zelle[^A-Za-z0-9@]{0,5}(?:me\\s*)?[@:]\\s*\\S{3,}"
    },
    {
      "id": "btc_address",
      "kind": "crypto",
      "caseInsensitive": false,
      "pattern": "(?<![A-Za-z0-9])(?:bc1[ac-hj-np-z02-9]{11,71}|[13](?=[a-km-zA-HJ-NP-Z1-9]*[A-HJ-NP-Z])(?=[a-km-zA-HJ-NP-Z1-9]*[a-km-z])[a-km-zA-HJ-NP-Z1-9]{25,34})(?![A-Za-z0-9])"
    },
    {
      "id": "eth_address",
      "kind": "crypto",
      "caseInsensitive": false,
      "pattern": "(?<![A-Za-z0-9])0x[a-fA-F0-9]{40}(?![A-Za-z0-9])"
    },
    {
      "id": "tron_address",
      "kind": "crypto",
      "caseInsensitive": false,
      "pattern": "(?<![A-Za-z0-9])T(?=[a-km-zA-HJ-NP-Z1-9]*[A-HJ-NP-Z])(?=[a-km-zA-HJ-NP-Z1-9]*[a-km-z])[a-km-zA-HJ-NP-Z1-9]{33}(?![A-Za-z0-9])"
    },
    {
      "id": "ltc_address",
      "kind": "crypto",
      "caseInsensitive": false,
      "pattern": "(?<![A-Za-z0-9])(?:ltc1[ac-hj-np-z02-9]{11,71}|[LM](?=[a-km-zA-HJ-NP-Z1-9]*[A-HJ-NP-Z])(?=[a-km-zA-HJ-NP-Z1-9]*[a-km-z])[a-km-zA-HJ-NP-Z1-9]{26,33})(?![A-Za-z0-9])"
    },
    {
      "id": "xmr_address",
      "kind": "crypto",
      "caseInsensitive": false,
      "pattern": "(?<![A-Za-z0-9])4[0-9AB][a-km-zA-HJ-NP-Z1-9]{93}(?![A-Za-z0-9])"
    },
    {
      "id": "crypto_wallet",
      "kind": "crypto",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])(?:bitcoin|btc|eth|ethereum|usdt|crypto|solana|sol)\\s*(?:wallet|address|addy)(?![A-Za-z0-9_])"
    },
    {
      "id": "telegram",
      "kind": "redirect",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])(?:telegram|tg)[^A-Za-z0-9@]{0,5}(?:me\\s*)?[@:]\\s*@?[A-Za-z0-9_]{4,32}|(?<![A-Za-z0-9_])t\\s*(?:\\.|dot|\\(dot\\)|\\[dot\\])\\s*me\\s*/\\s*[A-Za-z0-9_+]{3,}"
    },
    {
      "id": "whatsapp",
      "kind": "redirect",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])(?:whats\\s*app|wa)[^A-Za-z0-9+]{0,5}(?:me\\s*)?(?:[@:]\\s*)?\\+?[0-9][0-9 ().-]{6,18}[0-9]|(?<![A-Za-z0-9_])wa\\s*(?:\\.|dot|\\(dot\\)|\\[dot\\])\\s*me\\s*/\\s*\\+?[0-9]{6,}"
    },
    {
      "id": "snapchat",
      "kind": "redirect",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])snap(?:chat)?[^A-Za-z0-9@]{0,5}(?:me\\s*)?[@:]\\s*@?[A-Za-z0-9_.-]{3,15}"
    },
    {
      "id": "instagram",
      "kind": "redirect",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])(?:insta|instagram|ig)[^A-Za-z0-9@]{0,5}(?:me\\s*)?[@:]\\s*@?[A-Za-z0-9_.]{3,30}"
    },
    {
      "id": "kik",
      "kind": "redirect",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])kik[^A-Za-z0-9@]{0,5}(?:me\\s*)?[@:]\\s*@?[A-Za-z0-9_.]{3,30}"
    },
    {
      "id": "signal_username",
      "kind": "redirect",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])signal[^A-Za-z0-9@]{0,5}(?:me\\s*)?[@:]\\s*@?[A-Za-z][A-Za-z0-9_]{2,31}\\.[0-9]{2,9}(?![A-Za-z0-9_])"
    },
    {
      "id": "onlyfans",
      "kind": "redirect",
      "caseInsensitive": true,
      "pattern": "(?<![A-Za-z0-9_])only\\s*fans(?:\\s*(?:\\.|dot|\\(dot\\)|\\[dot\\])\\s*com|[^A-Za-z0-9@]{0,5}[@/:])|(?<![A-Za-z0-9_])(?:my|subscribe to|sub to|check out|link to my|link in my)\\s+(?:my\\s+)?only\\s*fans(?![A-Za-z0-9_])"
    }
  ],
