{
  "name": "stexx-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "bun": ">=1.3.0" },
  "scripts": {
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "bun src/db/migrate.ts",
    "db:migrate:test": "bun src/db/migrate.ts --test",
    "db:seed": "bun src/dev/seed.ts",
    "moderate": "bun scripts/moderate.ts",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit -p .",
    "check": "bun run typecheck && bun test --timeout 30000"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@simplewebauthn/server": "14.0.3",
    "hono": "4.13.16",
    "nodemailer": "10.2.1",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "@types/nodemailer": "8.0.2",
    "typescript": "5.9.3"
  }
}
