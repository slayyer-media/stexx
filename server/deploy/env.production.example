# /etc/stexx/stexx.env  (root:root 0600). Loaded by stexx-api.service via EnvironmentFile.
# bootstrap.sh creates this file with generated secrets; this is the reference for every variable.
# The service unit also sets NODE_ENV=production, HOST=127.0.0.1, PORT=8787, MEDIA_DIR=/srv/stexx/media.
#
# Production REFUSES TO BOOT if any STEXX_DEV_* variable is set, EMAIL_PEPPER is missing/short/the dev default,
# MEDIA_BASE_URL or APP_LINK_BASE is not https, WEBAUTHN_RP_ID is localhost, or DATABASE_URL uses the dev password.

# Postgres over loopback as the least-privilege role (DML only). Hex password => no URL escaping needed.
DATABASE_URL=postgres://stexx_app:CHANGE_ME_HEX@127.0.0.1:5432/stexx
DATABASE_POOL_MAX=10

# Public URLs (no trailing slash)
MEDIA_BASE_URL=https://media.stexx.gay
APP_LINK_BASE=https://stexx.gay

# HMAC key for email addresses (we never store the address). `openssl rand -hex 32`.
# BACK THIS UP in your password manager: it is NOT in the database backups, and losing or changing it
# makes every email-based account unreachable (HMACs no longer match).
EMAIL_PEPPER=CHANGE_ME_openssl_rand_hex_32

# Outbound mail for sign-in links. Without it, email sign-in returns 503 email_unavailable in production.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Quoted because deploy.sh also sources this file with bash (systemd strips the quotes).
MAIL_FROM="Stexx <no-reply@stexx.gay>"

# Passkeys. The RP ID must match the apple-app-site-association webcredentials entry served at https://stexx.gay.
WEBAUTHN_RP_ID=stexx.gay
WEBAUTHN_RP_NAME=Stexx
WEBAUTHN_ORIGINS=https://stexx.gay

# Stexx+ (StoreKit 2). Enabled only when APPLE_ROOT_CA_DIR is set (and APPLE_APP_APPLE_ID for Production).
# The repo ships Apple's public root CA in server/certs/, uploaded with every release; point at it via `current`.
APPLE_BUNDLE_ID=gay.stexx.app
APPLE_ENVIRONMENT=Production
# APPLE_APP_APPLE_ID=1234567890
# APPLE_ROOT_CA_DIR=/srv/stexx/current/certs
APPLE_PLUS_PRODUCT_ID=gay.stexx.app.plus.monthly

# Anti-spam (docs/security.md). Setting APPLE_TEAM_ID turns on ATTESTATION_MODE=enforce: only attested app
# builds can sign up, log in, message or upload photos. Ship an attesting build first, or set ATTESTATION_MODE=off
# to stage it. ATTESTATION_MODE=dev is refused in production.
# APPLE_TEAM_ID=ABCDE12345
# ATTESTATION_MODE=enforce
# DeviceCheck (per-device bits that survive reinstalls). The .p8 from Apple on one line with \n escapes, quoted.
# DEVICECHECK_KEY_ID=XXXXXXXXXX
# DEVICECHECK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# MAX_ACCOUNTS_PER_DEVICE=1
# Optional overrides: TRUST_RAMP_* and RATE_LIMIT_<ACTION>_<SCOPE>=<count>/<window>, see docs/security.md.
# Reports: REPORT_AUTOHIDE_THRESHOLD (3), REPORT_AUTOHIDE_WINDOW_DAYS (14), REPORT_UNDERAGE_*_THRESHOLD,
# REPORT_EVIDENCE_RETENTION_DAYS (30); see docs/security.md section 5.
# End-to-end encryption (docs/security.md section 6): keep off until the iOS build with libsignal ships, then optional,
# then required once old builds are gone.
# E2E_MODE=off

# Photo checks (docs/security.md). The unit sets PHOTO_NSFW_MODEL=/srv/stexx/models/nudenet-320n.onnx and deploy.sh
# downloads it. Optional: fail closed while the model is missing, and a stock/scraped photo hash list.
# PHOTO_HIDE_UNCHECKED=1
# PHOTO_HASH_BLOCKLIST=/etc/stexx/photo-blocklist.txt

# Caddy is the only peer; CF-Connecting-IP is trusted from loopback only and used transiently (hashed) for rate limits.
TRUST_PROXY=1
