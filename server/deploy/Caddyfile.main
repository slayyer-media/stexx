# /etc/caddy/Caddyfile for a dedicated Stexx box. The site blocks live in sites/stexx.caddy
# (deploy/Caddyfile in the repo). On a shared box, merge the global block below into the existing one.
{
	# Origin sits behind Cloudflare only (ufw enforces it, see deploy/README.md). Trust
	# CF-Connecting-IP only from Cloudflare's published ranges. Verify against
	# https://www.cloudflare.com/ips/ every few months (ufw-cloudflare.sh fetches the live list).
	servers {
		protocols h1 h2
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}

	# Caddy's runtime logs: warnings and errors only, and never the request-scoped namespaces
	# (http.log.access / http.log.error carry remote_ip, URI and headers).
	log {
		level WARN
		exclude http.log.access http.log.error
	}
}

import /etc/caddy/sites/*.caddy
