# /etc/stexx/caddy-admin.env  (root:root 0644, no secrets). Read by Caddy (systemd drop-in installed by
# deploy.sh --sync-config --with-admin) and by the shell that validates the Caddy config before a reload.
# Used only by Caddyfile.admin: the public Caddyfile never mentions these.

# The console's tailnet name: must equal the host of ADMIN_ORIGIN in /etc/stexx/admin.env.
STEXX_ADMIN_HOST=stexx-admin.CHANGE_ME.ts.net
# The port the console answers on (optional, default 8443): must equal the port in ADMIN_ORIGIN, and is the port
# `ufw-cloudflare.sh --tailscale-admin` opens on tailscale0 (set STEXX_ADMIN_PORT there too if you change it).
# Not 443: Caddy can't share it with the public sites while keeping the console off the public interface (see Caddyfile.admin).
# STEXX_ADMIN_PORT=8443
