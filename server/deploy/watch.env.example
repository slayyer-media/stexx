# /etc/stexx/watch.env (root:root 0600, optional). Read by /usr/local/sbin/stexx-watch (stexx-watch.timer, every
# 5 minutes) and by stexx-alert@.service. Alerting is OFF until ALERT_EMAIL or ALERT_WEBHOOK_URL is set.
# Test it with:  sudo /usr/local/sbin/stexx-watch --test-alert
#
# Alerts carry check and unit names only (no user data, no addresses, no numbers from the database).

# Email through the API's SMTP relay (SMTP_URL and MAIL_FROM in /etc/stexx/stexx.env). Override with
# ALERT_SMTP_URL=smtps://user:pass@host:465 and ALERT_MAIL_FROM=alerts@example.org if alerts should use another relay.
# ALERT_EMAIL=ops@example.org

# Plain-text POST; a self-hosted ntfy topic works as is (Title header, body = message). https only (or http://localhost).
# ALERT_WEBHOOK_URL=https://ntfy.example.org/stexx-ops-<random>
# ALERT_WEBHOOK_TOKEN=tk_...          # sent as "Authorization: Bearer ..." (ntfy access token)

# Repeat an unchanged problem at most this often (hours). A new or changed problem alerts at once.
# ALERT_REPEAT_HOURS=6
# Name in the subject line. Not the hostname on purpose (provider hostnames can embed the IP).
# ALERT_LABEL=stexx

# Thresholds (defaults shown)
# WATCH_BACKUP_MAX_AGE_HOURS=30
# WATCH_LOCAL_HEALTH_URL=http://127.0.0.1:8787/healthz
# WATCH_PUBLIC_HEALTH_URL=https://api.stexx.gay/healthz      # empty to skip
# WATCH_DISK_PATHS="/srv/stexx/media /var/lib/postgresql"
# WATCH_DISK_WARN_PCT=15
# WATCH_DISK_FAIL_PCT=5
# WATCH_TLS_HOSTS="api.stexx.gay media.stexx.gay"            # origin certificates, read through 127.0.0.1:443
# WATCH_TLS_CONNECT=127.0.0.1:443
# WATCH_TLS_WARN_DAYS=14
# WATCH_TLS_FAIL_DAYS=3
# WATCH_ERROR_THRESHOLD=20                                    # level:"error" lines from stexx-api per run
# WATCH_INTERVAL_SEC=300                                      # first-run look-back; keep equal to the timer
