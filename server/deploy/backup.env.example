# /etc/stexx/backup.env (optional). Read by /usr/local/sbin/stexx-backup (and by stexx-watch for the pre-migrate TTL).
STEXX_BACKUP_REMOTE=b2:stexx-backups/db
STEXX_BACKUP_DB=stexx
# Retention in days, 1..28. The product promise is "deleted within 30 days, including backups" (28 leaves a margin).
STEXX_BACKUP_KEEP_DAYS=28
# CONTENT tables whose rows are NOT backed up (schema is kept). Messages are excluded so expiring/view-once content
# never outlives its timer in a backup; location cells and profile views so nightly dumps never become the
# location/view history the product promises not to keep. Leave this commented out to follow the default as it
# changes; set it to empty to back these up. Credentials, short-lived state, report evidence, spam-detection features
# and taps (sessions, email_link_tokens, auth_challenges, attest_challenges, abuse_counters, e2e_one_time_prekeys,
# report_evidence, spam_message_features, taps) are ALWAYS left out and can't be put back here.
#STEXX_BACKUP_EXCLUDE_DATA="messages media_trash locations travel_locations profile_views"
# 1: reports are backed up as a separate encrypted CSV with `details` and `reporter_ip_hash` nulled (default).
# 0: reports rows go into the archive unchanged (free text included). Add `reports` above to leave them out entirely.
STEXX_BACKUP_REDACT_REPORTS=1
# Full pre-migration snapshots (deploy.sh runs `stexx-backup --pre-migrate` as root). Never uploaded. Must be a
# root-only directory whose parent only root can write to (default /var/lib/stexx-premigrate); backup.sh refuses others.
#STEXX_PREMIGRATE_DIR=/var/lib/stexx-premigrate
# Hours before stexx-watch deletes a snapshot, 1..24.
STEXX_PREMIGRATE_TTL_HOURS=24
# At most this many pre-migrate snapshots stay on disk (1..5); older ones are deleted once a new one is in place.
#STEXX_PREMIGRATE_KEEP=2
# A pre-migrate snapshot is refused unless this much of its filesystem (usually Postgres's too) stays free, 0..90.
#STEXX_PREMIGRATE_MIN_FREE_PCT=15
