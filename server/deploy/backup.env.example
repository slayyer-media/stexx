# /etc/stexx/backup.env (optional). Read by /usr/local/sbin/stexx-backup (and by stexx-watch for the pre-migrate TTL).
STEXX_BACKUP_REMOTE=b2:stexx-backups/db
STEXX_BACKUP_DB=stexx
# Retention in days, 1..28. The product promise is "deleted within 30 days, including backups" (28 leaves a margin).
STEXX_BACKUP_KEEP_DAYS=28
# CONTENT tables whose rows are NOT backed up (schema is kept). Messages and report evidence are excluded so
# expiring/view-once content and shared report plaintext never outlive their timers in a backup; location cells and
# profile views so nightly dumps never become the location/view history the product promises not to keep. Set to
# empty to back these up. Credentials and short-lived state (sessions, email_link_tokens, auth_challenges,
# attest_challenges, abuse_counters, e2e_one_time_prekeys) are ALWAYS left out and are not listed here.
STEXX_BACKUP_EXCLUDE_DATA="messages report_evidence media_trash locations travel_locations profile_views"
# 1: reports are backed up as a separate encrypted CSV with `details` and `reporter_ip_hash` nulled (default).
# 0: reports rows go into the archive unchanged (free text included). Add `reports` above to leave them out entirely.
STEXX_BACKUP_REDACT_REPORTS=1
# Full pre-migration snapshots (deploy.sh runs `stexx-backup --pre-migrate` as root). Never uploaded.
STEXX_PREMIGRATE_DIR=/var/lib/stexx-backup/pre-migrate
# Hours before stexx-watch deletes a snapshot, 1..24.
STEXX_PREMIGRATE_TTL_HOURS=24
