# /etc/stexx/backup.env (optional). Read by /usr/local/sbin/stexx-backup.
STEXX_BACKUP_REMOTE=b2:stexx-backups/db
STEXX_BACKUP_DB=stexx
# Retention in days, 1..28. The product promise is "deleted within 30 days, including backups" (28 leaves a margin).
STEXX_BACKUP_KEEP_DAYS=28
# Tables whose rows are NOT backed up (schema is kept). Messages are excluded so expiring/view-once content
# never outlives its timer in a backup; location cells and profile views so nightly dumps never become the
# location/view history the product promises not to keep. Set to empty to back up everything.
STEXX_BACKUP_EXCLUDE_DATA="messages email_link_tokens auth_challenges media_trash locations travel_locations profile_views"
