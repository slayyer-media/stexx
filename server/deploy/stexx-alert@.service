[Unit]
Description=Stexx alert: %i failed
Documentation=https://github.com/stexx/stexx/blob/main/server/deploy/README.md
# Started by OnFailure=stexx-alert@%n.service in stexx-api, stexx-backup and stexx-watch. Sends the unit NAME only to
# ALERT_EMAIL / ALERT_WEBHOOK_URL (/etc/stexx/watch.env); does nothing when neither is set. Debounced per unit.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/stexx-watch --alert-unit %i
SyslogIdentifier=stexx-alert
TimeoutStartSec=2min
StateDirectory=stexx-watch
StateDirectoryMode=0700

NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
