# /etc/stexx/admin.env  (root:root 0600). Loaded by stexx-admin.service AFTER stexx.env, so it adds the staff console's
# own settings on top of the shared ones (DATABASE_URL, EMAIL_PEPPER, ...). The API never reads it.
# Reference: docs/security.md "Staff console". Not set here, and refused if you try: NODE_ENV, HOST, PORT, MEDIA_DIR,
# ADMIN_HOST (the unit pins 127.0.0.1) and ADMIN_PORT (the unit pins 8788).
#
# Quoted because deploy.sh also sources this file with bash (systemd strips the quotes).
#
# THE HOSTNAME IS A ONE-WAY DOOR. Staff passkeys are bound to ADMIN_RP_ID. Changing the hostname later means
# every staff member enrolls again (invite from the CLI). Pick the tailnet name once, before the first invite.
# AND IT IS PUBLIC. The certificate tailscaled gets for it is logged in Certificate Transparency (anyone can search
# those), and *.ts.net names can resolve in public DNS (to the tailnet address, which only the tailnet can reach). Use a
# neutral machine name that doesn't say what it is: not "stexx-admin", "console" or "staff".

# The console's own origin: https, the tailnet name and port Caddy answers on (STEXX_ADMIN_HOST and STEXX_ADMIN_PORT
# in /etc/stexx/caddy-admin.env; the port is 8443 unless you changed it), no path. REQUIRED: without it the console
# refuses to start (the API is unaffected). The passkey relying party is the host only, without the port.
ADMIN_ORIGIN="https://CHANGE_ME-neutral-name.CHANGE_ME-tailnet.ts.net:8443"

# WebAuthn relying party id. Defaults to the host of ADMIN_ORIGIN, and must equal it. Must differ from WEBAUTHN_RP_ID
# so a staff passkey never works on the app and the reverse. Normally leave unset.
# ADMIN_RP_ID="CHANGE_ME-neutral-name.CHANGE_ME-tailnet.ts.net"
# ADMIN_RP_NAME="Stexx staff"

# Defense in depth behind the private network: the forwarded client address must be inside these ranges (it is checked
# and dropped, never stored or logged). Default is Tailscale's: 100.64.0.0/10 and fd7a:115c:a1e0::/48. Narrow it if you
# give staff devices a smaller range.
# ADMIN_ALLOWED_CIDRS="100.64.0.0/10,fd7a:115c:a1e0::/48"

# Sessions and step-up. Defaults: 30 minutes idle, 8 hours absolute, 5 minutes for a fresh passkey check before a
# destructive action. Idle may not exceed absolute.
# ADMIN_SESSION_IDLE_MINUTES=30
# ADMIN_SESSION_ABSOLUTE_HOURS=8
# ADMIN_STEP_UP_MINUTES=5

# ADMIN_DEV_AUTH (passkey-less dev login) exists for local development only. Production refuses to boot with it set,
# and deploy.sh does not upload the file that implements it.
