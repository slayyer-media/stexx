<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Debug and Release configurations (CODE_SIGN_ENTITLEMENTS
  in project.yml). StexxLocal.entitlements is the Local configuration's copy:
  keep both in sync, except for the associated domains (passkeys and email
  links), which only this file has.
-->
<plist version="1.0">
<dict>
	<!-- App Attest (DCAppAttestService). The App ID needs the App Attest
	     capability in the Apple Developer account; automatic signing adds it. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>$(STEXX_APP_ATTEST_ENVIRONMENT)</string>
	<!-- Passkeys for the relying party (STEXX_PASSKEY_RP_ID, the server's
	     WEBAUTHN_RP_ID), and email sign-in links (STEXX_APP_LINK_HOST, the
	     host of the server's APP_LINK_BASE) as universal links. Each domain
	     must serve an apple-app-site-association that lists the app
	     (server/deploy/README.md). Automatic signing adds the capability. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:$(STEXX_PASSKEY_RP_ID)</string>
		<string>applinks:$(STEXX_APP_LINK_HOST)</string>
	</array>
</dict>
</plist>
